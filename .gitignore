# Parametros locales del pase a calidad (servidor, logins). Nunca versionar.
pase/parametros.ps1

# SQL concatenados del pase (se regeneran con generar_sql.ps1 / empacar_pase.ps1)
pase/01_SIGA.sql
pase/02_DBSIGCM.sql
pase/03_SSO.sql
_bitacora/
*.log

# Salidas de C000B generadas al vuelo. La copia que SI se versiona es la de
# docs/, que documenta un entorno concreto en una fecha concreta.
diagnostico_*.txt

# Ruido de Windows y de los editores
Thumbs.db
desktop.ini
.vs/
*.swp
*~

# Archivos de bloqueo que deja Word mientras un .docx esta abierto
~$*

# Datos de una corrida local (expediente, pedido, cuadro concretos).
# No aplican al recrear DBSIGCM en el ANIN. El flujo real usa usp_ext_*.
SIGA/integracion/_local/
SIGA/integracion/copiar_tdr_*.sql
SIGA/integracion/preparar_prueba_*.sql
SIGA/integracion/homologar_cuadro_adquisicion_pedido_*.sql
